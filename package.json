{
  "name": "openledger-eval",
  "version": "0.2.0",
  "private": true,
  "description": "Evals how fit the OpenLedger CLI and skill are for AI models.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env src/server/app.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "npm run build && tsx --env-file-if-exists=.env src/server/app.ts",
    "eval": "tsx --env-file-if-exists=.env src/main.ts",
    "dashboard:legacy": "tsx src/dashboard/server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "test": "tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "chalk": "^5.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "es-toolkit": "^1.50.0",
    "hono": "^4.13.1",
    "lucide-react": "^1.30.0",
    "openai": "^6.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.5.0",
    "vite": "^8.2.1"
  }
}
