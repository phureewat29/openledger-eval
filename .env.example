# OpenRouter is the only engine; create a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# The CLI under test is whichever `oled` is on PATH — `npm install -g oled`,
# or `npm link` from a local build. Nothing to configure here.

# Endpoint tuning (defaults shown)
LLM_STREAM=true
LLM_TIMEOUT_MS=600000

# Escape hatch, normally unset:
# LLM_INPUT_MODALITIES=text,image
